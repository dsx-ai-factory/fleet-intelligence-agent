set -eu

# --subject validates a PR title strictly; file mode is Git's commit-msg hook.
if [ "${1:-}" = "--subject" ]; then
  [ "$#" -eq 2 ] || exit 1
  subject=$2
else
  [ "$#" -eq 1 ] || exit 1
  subject=$(sed '/^[[:space:]]*$/d; /^#/d' "$1" | head -n 1)
  # Allow Git-generated subjects and temporary rebase commits locally.
  case "$subject" in
    "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
  esac
fi

# Titles and commit subjects must be a single line.
case "$subject" in
  *'
'*) echo "Subject must be a single line." >&2; exit 1 ;;
esac

pattern='^(feat|fix|perf|refactor|docs|chore|test|revert)(\([a-z0-9._/-]+\))?!?: [^[:space:]].*$'
if ! printf '%s\n' "$subject" | LC_ALL=C grep -qE "$pattern"; then
  cat >&2 <<'EOF'
Expected: <type>(<scope>): <description>
Scope is optional. Add ! after the type/scope for a breaking change.
Allowed types: feat, fix, perf, refactor, docs, chore, test, revert
Examples:
  feat(cli): add inventory command
  fix: handle missing chassis
  feat(api)!: remove deprecated endpoint
EOF
  exit 1
fi
